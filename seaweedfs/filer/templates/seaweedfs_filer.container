#SPDX-License-Identifier: MIT-0
[Unit]
Description=Seaweedfs filer {{ ip }}:{{ svc_port }}
#After=network.target
Requires=network-online.target
After=network-online.target

[Container]
PodmanArgs=--entrypoint /usr/bin/weed
Image={{ seaweedfs_container }}
{% if seaweedfs_security_enabled is sameas true %}
Exec=filer -ip {{ ip }} -ip.bind {{ ip_bind }} -port {{ svc_port }} -port.grpc {{ svc_port_grpc }} -master={{ masters }} -dataCenter={{ dataCenter }} -rack={{ rack }} -defaultStoreDir {{ defaultStoreDir }} -disableHttp
{% else %}
Exec=filer -ip {{ ip }} -ip.bind {{ ip_bind }} -port {{ svc_port }} -port.grpc {{ svc_port_grpc }} -master={{ masters }} -dataCenter={{ dataCenter }} -rack={{ rack }} -defaultStoreDir {{ defaultStoreDir }}
{% endif %}
Volume={{ defaultStoreDir }}:{{ defaultStoreDir }}:z
Volume=/etc/seaweedfs:/etc/seaweedfs:z,ro
Network=host

[Service]
Restart=always

[Install]
WantedBy=multi-user.target






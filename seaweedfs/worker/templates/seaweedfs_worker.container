#SPDX-License-Identifier: MIT-0
[Unit]
Description=Seaweedfs worker 
#After=network.target
Requires=network-online.target
After=network-online.target

[Container]
PodmanArgs=--entrypoint /usr/bin/weed
Image={{ seaweedfs_container }}
Exec=worker -admin {{ admin }} -workingDir {{ workingDir }}"
Volume={{ workingDir }}:{{ workingDir }}:z
Volume=/etc/seaweedfs:/etc/seaweedfs:z,ro
Network=host

[Service]
Restart=always

[Install]
WantedBy=multi-user.target

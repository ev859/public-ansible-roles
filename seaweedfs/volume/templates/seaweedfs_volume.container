#SPDX-License-Identifier: MIT-0
[Unit]
Description=Seaweedfs volume {{ dir }} {{ ip }}:{{ svc_port }}
#After=network.target
Requires=network-online.target
After=network-online.target

[Container]
PodmanArgs=--entrypoint /usr/bin/weed
Image={{ seaweedfs_container }}
Exec=volume -dir={{ dir }} -dataCenter={{ dataCenter }} -rack={{ rack }} -ip {{ ip }} -ip.bind {{ ip_bind }} -port={{ svc_port }} -port.grpc={{ svc_port_grpc }} -master={{ masters }} -max={{ max }} -compactionMBps {{ compactionMBps }} -maintenanceMBps {{ maintenanceMBps }} -index {{ index }}
Volume={{ dir }}:{{ dir }}:z
Volume=/etc/seaweedfs:/etc/seaweedfs:z,ro
Network=host

[Service]
Restart=always

[Install]
WantedBy=multi-user.target


